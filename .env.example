# =============================================================================
# 腾讯文档智能表 MCP Server 环境变量示例
# 复制为 .env 后按实际环境填写；不要提交 .env 到版本库。
# 需求文档 §6.1；本文件中的默认值与 src/config.ts 保持一致。
# =============================================================================

# ---------------------------------------------------------------------------
# 1. 腾讯文档 OpenAPI 凭证（必填；缺失时服务仍启动，工具返回 CONFIG_MISSING）
# ---------------------------------------------------------------------------
# 腾讯文档 Access-Token（密钥，留空；切勿提交真实值）
ACCESS_TOKEN=
# 应用 Client-Id（密钥，留空）
CLIENT_ID=
# 用户 Open-Id（密钥，留空）
OPEN_ID=

# 推荐表 sheetID：新增工具未传 recommendSheetID 时用于候选人校验（可选）
RECOMMEND_SHEET_ID=

# ---------------------------------------------------------------------------
# 2. 服务与鉴权
# ---------------------------------------------------------------------------
# 监听端口，默认 3000
HTTP_PORT=3000
# 保护 POST /mcp 的 Bearer Token；留空表示不校验（公网部署强烈建议设置）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=
# 日志级别：trace / debug / info / warn / error / fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# 3. 业务规则
# ---------------------------------------------------------------------------
# 置信度阈值（0–1），低于阈值的写入会标记「待确认说明」
CONFIDENCE_THRESHOLD=0.8
# 单次查询默认最大扫描记录数
MAX_SCAN_RECORDS=1000
# options.max_records 的上限
MAX_SCAN_RECORDS_CAP=5000
# 官方分页大小，最大 100
PAGE_SIZE=100
# 推荐表找不到候选人时，是否仍写入面试安排表（并在待确认列标记）
ALLOW_ORPHAN_ADD=true
# 是否写入/清空「待确认说明」（可被单次 options.mark_pending 覆盖）
MARK_PENDING=true
# 待确认说明文本最大长度
PENDING_TEXT_MAX_LENGTH=500

# ---------------------------------------------------------------------------
# 4. 列名映射（FIELD_*）：必须与腾讯文档智能表实际列标题完全一致
# ---------------------------------------------------------------------------
# 候选人 ID（推荐表自增列 / 安排表关联列）
FIELD_CANDIDATE_ID=candidate_id
# 姓名
FIELD_NAME=姓名
# 应聘岗位（推荐表摘要）
FIELD_POSITION=应聘岗位
# 推荐表「面试阶段」（公式列，只读，MCP 不写）
FIELD_RECOMMEND_STAGE=面试阶段
# 推荐表「是否通过」（公式列，只读，MCP 不写）
FIELD_RECOMMEND_RESULT=是否通过
# 面试日期（安排表）
FIELD_INTERVIEW_DATE=面试日期
# 面试阶段（安排表）
FIELD_INTERVIEW_STAGE=面试阶段
# 面试老师（安排表）
FIELD_INTERVIEWER=面试老师
# 面试评价（安排表，面评正文不落日志）
FIELD_FEEDBACK=面试评价
# 安排表「是否通过」（安排表，MCP 可写）
FIELD_INTERVIEW_RESULT=是否通过
# 是否最新（安排表公式列，只读，MCP 不写）
FIELD_IS_LATEST=是否最新
# MCP 管理的待确认说明列（推荐列名）
PENDING_COLUMN=待确认说明
# 兼容别名：未设置 PENDING_COLUMN 时读取；通常无需设置
# FIELD_PENDING=待确认说明

# ---------------------------------------------------------------------------
# 5. 枚举与别名归一化
# ---------------------------------------------------------------------------
# 允许写入的面试阶段枚举（逗号分隔）；留空表示不校验
INTERVIEW_STAGES=初试,复试,终试,HR面
# 面试结果别名表（JSON 对象，key 会自动小写并去空白）；{} 表示使用内置默认表
RESULT_ALIASES={}
# 面试阶段别名表（JSON 对象）；{} 表示使用内置默认表（一面→初试、二面→复试等）
STAGE_ALIASES={}

# ---------------------------------------------------------------------------
# 6. 工作时间（Asia/Shanghai，仅用于业务提示/校验）
# ---------------------------------------------------------------------------
# 起始小时（含），0–24
WORKING_HOURS_START=9
# 结束小时（不含），0–24
WORKING_HOURS_END=20
# 工作日，ISO 星期：1=周一 … 7=周日（逗号分隔）
WORKING_DAYS=1,2,3,4,5

# ---------------------------------------------------------------------------
# 7. 腾讯文档 API 连接与限流
# ---------------------------------------------------------------------------
# API 基地址（一般无需修改；测试/代理时可覆盖）
TENCENT_DOCS_BASE_URL=https://docs.qq.com
# 单次请求超时（毫秒）
REQUEST_TIMEOUT_MS=10000
# 429/5xx/网络错误的最大重试次数（0–5）
MAX_RETRIES=2
# 每次重试的退避间隔（毫秒，逗号分隔；不足时沿用最后一个）
RETRY_DELAYS_MS=500,1500
# 客户端限流：同一 fileID 每分钟最大请求数
RATE_LIMIT_FILE_PER_MINUTE=120
# 客户端限流：同一 Open-Id 每分钟最大请求数
RATE_LIMIT_OPENID_PER_MINUTE=250
